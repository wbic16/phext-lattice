[Unit]
Description=phext-edit — web-served phext editor
After=network.target

[Service]
Type=simple
# GitHub/Google sign-in settings (optional; see deploy.md step 4b)
EnvironmentFile=-/etc/phext-edit/oauth.env
User=wbic16
ExecStart=/source/phext-lattice/target/release/phext-edit --dir /source/human --home choose-your-own-adventure.phext --home-coord 10.10.2/1.1.1/1.10.10 --port 8080 --token REPLACE_WITH_TOKEN
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
