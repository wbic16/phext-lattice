# phext-edit container environment — example, placeholders only.
#
# Copy to `phext-edit.env` in the repository root (compose.yaml reads
# it from there), fill in real values, and keep the filled copy out of
# git and out of the image: it is listed in .dockerignore, and real
# credentials must never be committed or baked into an image layer.
#
# The same variables configure the systemd deployment — deploy.sh
# writes them to /etc/phext-edit/oauth.env. Full contract:
# deploy/CONTAINER.md.

# Public origin the OAuth callbacks are registered under.
PHEXT_PUBLIC_URL=https://edit.phext.io
# Session signing secret. Generate once: openssl rand -hex 32
PHEXT_SESSION_SECRET=replace-me
# 1 when PHEXT_PUBLIC_URL is https.
PHEXT_COOKIE_SECURE=1
# Editor allowlist. Empty: any signed-in account gets in. To restrict,
# list github:<numeric id>, google:<sub>, x:<id>, or a verified email,
# comma-separated.
PHEXT_EDITORS=

# OAuth apps. Callback URL per provider:
# https://edit.phext.io/api/auth/<provider>/callback
# Leave a provider's pair empty to keep that provider off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional. Claim mode, and the shared-secret SSO handoffs to Mutable,
# Exocortexia, and Wishnode, plus the desktop audience (deploy/deploy.md
# has the deploy order).
# PHEXT_SSO_SECRET is a dedicated key — never reuse the session secret.
#PHEXT_CLAIM_ENABLED=1
#PHEXT_SSO_SECRET=
#PHEXT_SSO_MUTABLE_URL=https://mutable.phext.io
#PHEXT_SSO_EXOCORTEXIA_URL=
#PHEXT_SSO_WISHNODE_URL=
# Arming flag only — the desktop (Phext Notepad) audience has no origin
# to configure; the return is the app's per-attempt loopback listener.
# Until this is exactly 1, both desktop endpoints answer 404.
#PHEXT_SSO_DESKTOP=1

# Support the site donation. A public Stripe Payment Link, not an ad and not a
# Stripe secret. deploy.sh writes the live link when this is unset. Empty hides it.
#PHEXT_SPONSOR_URL=https://donate.stripe.com/9B6dRa2t08tu7jUgxo5Vu0b
